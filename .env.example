# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ENVIRONMENT CONFIGURATION FOR MULTI-VENDOR MARKETPLACE
NODE_ENV="development"
PORT=3000

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/primebazaar_db?schema=public"

# Redis Cache & Background Queue (BullMQ)
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your_jwt_access_secret_key_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"

# Object Storage (AWS S3 or Cloudflare R2 for Images & Videos)
S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
S3_BUCKET="primebazaar-media-assets"
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="your_s3_secret_key"

# Payment Gateways (Razorpay & Cashfree Sandbox/Live)
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"

# Shipping & Logistics Providers (Shiprocket & Delhivery Express)
SHIPROCKET_EMAIL="logistics@primebazaar.in"
SHIPROCKET_PASSWORD="your_shiprocket_password"

# Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID="primebazaar-prod"
FIREBASE_SERVICE_ACCOUNT="path/to/firebase-service-account.json"

# Transactional Email & SMS Gateway
BREVO_API_KEY="your_brevo_email_api_key"
SMS_PROVIDER_API_KEY="your_msg91_api_key"

# OpenSearch Cluster & Error Monitoring (Sentry)
OPENSEARCH_URL="http://localhost:9200"
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
