  invoice           TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refundId          String?
  refund            Refund?    @relation(fields: [refundId], references: [id], onDelete: Restrict)
  reason            String
  taxableAdjustment Decimal    @db.Decimal(12, 2)
  cgstAdjustment    Decimal    @default(0.0) @db.Decimal(12, 2)
  sgstAdjustment    Decimal    @default(0.0) @db.Decimal(12, 2)
  igstAdjustment    Decimal    @default(0.0) @db.Decimal(12, 2)
  totalAdjustment   Decimal    @db.Decimal(12, 2)
  issuedBy          String
  issuedAt          DateTime   @default(now())

  @@index([invoiceId])
  @@map("credit_notes")
}

enum LedgerEntrySide {
  DEBIT
  CREDIT
}

enum LedgerEntryStatus {
  POSTED
  REVERSED
}

model FinanceLedgerEntry {
  id              String            @id @default(uuid())
  entryGroupId    String
