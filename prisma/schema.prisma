  referenceNumber String
  description     String
  status          LedgerEntryStatus @default(POSTED)
  createdBy       String
  createdAt       DateTime          @default(now())

  @@index([entryGroupId])
  @@index([accountCode, createdAt])
  @@index([orderId])
  @@index([sellerId])
  @@map("finance_ledger_entries")
}

enum ReconciliationMatchStatus {
  MATCHED
  UNMATCHED_INTERNAL
  UNMATCHED_PROVIDER
  AMOUNT_MISMATCH
  DUPLICATE
  FAILED
  PENDING
}

model ReconciliationRun {
  id             String   @id @default(uuid())
  fromDate       DateTime
  toDate         DateTime
  runBy          String
  totalChecked   Int
  matchedCount   Int
  unmatchedCount Int
  mismatchCount  Int
  duplicateCount Int
  createdAt      DateTime @default(now())

