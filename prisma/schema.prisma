// =============================================================================
// PRIME BAZAAR – CENTRAL MULTI-VENDOR MARKETPLACE POSTGRESQL PRISMA SCHEMA
// Supports Customer App (Web & Mobile), Autonomous Seller Studio & Super Admin Console
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// SECTION 2.A: USER AND SELLER TABLES
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String?     @unique
  phone        String?     @unique
  passwordHash String?
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  userRoles      UserRole[]
  sellerProfile  SellerProfile?
  orders         Order[]
  productReviews ProductReview[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@map("users")
  @@index([email])
  @@index([phone])
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique // e.g. "CUSTOMER", "SELLER", "SUPER_ADMIN", "OPERATIONS_ADMIN"
  description String?
  userRoles   UserRole[]
  createdAt   DateTime   @default(now())

  @@map("roles")
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

enum SellerApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  INDIVIDUAL_ARTISAN
}

model SellerProfile {
  id             String               @id @default(uuid())
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName   String
  tradeName      String?
  businessType   BusinessType         @default(PROPRIETORSHIP)
  approvalStatus SellerApprovalStatus @default(PENDING_APPROVAL)
  rejectionReason String?
  rating         Decimal              @default(5.0) @db.Decimal(3, 2)
  totalOrders    Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  documents      SellerDocument[]
  addresses      SellerAddress[]
  bankAccounts   SellerBankAccount[]
  settings       SellerSettings?
  products       Product[]
  sellerOrders   SellerOrder[]
  shipments      Shipment[]
  wallet         SellerWallet?
  transactions   SellerTransaction[]
  settlements    Settlement[]
  commissionEntries CommissionEntry[]

  @@map("seller_profiles")
  @@index([businessName])
  @@index([approvalStatus])
}

enum DocumentType {
  PAN_CARD
  GSTIN_CERTIFICATE
  CANCELLED_CHEQUE
  ADDRESS_PROOF
  TRADE_LICENSE
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model SellerDocument {
  id                 String                     @id @default(uuid())
  sellerId           String
  seller             SellerProfile              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  documentType       DocumentType
  documentUrl        String
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  rejectionNote      String?
  createdAt          DateTime                   @default(now())

  @@map("seller_documents")
  @@index([sellerId])
}

model SellerAddress {
  id        String        @id @default(uuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  address   String        // street address
  city      String
  state     String
  pincode   String
  isDefault Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@map("seller_addresses")
}

model SellerBankAccount {
  id                     String        @id @default(uuid())
  sellerId               String
  seller                 SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  accountHolder          String
  accountNumberEncrypted String
  bankName               String
  ifsc                   String
  isVerified             Boolean       @default(false)
  isDefault              Boolean       @default(true)
  createdAt              DateTime      @default(now())

  @@map("seller_bank_accounts")
}

model SellerSettings {
  id                   String        @id @default(uuid())
  sellerId             String        @unique
  seller               SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  returnPolicy         String        @default("7 days doorstep replacement for manufacturing defects")
  processingTimeDays   Int           @default(1)
  notificationSettings Json?         // Email, SMS, WhatsApp dispatch alerts
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("seller_settings")
}

// =============================================================================
// SECTION 2.B: PRODUCT AND INVENTORY TABLES
// =============================================================================

model Category {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  parentId        String?
  parent          Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryHierarchy")
  products        Product[]
  commissionRules CommissionRule[]
  createdAt       DateTime         @default(now())

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  products  Product[]
  createdAt DateTime  @default(now())

  @@map("brands")
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  REJECTED
  INACTIVE
  SUSPENDED
}

model Product {
  id          String        @id @default(uuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?        @relation(fields: [brandId], references: [id])
  name        String
  description String
  status      ProductStatus @default(PENDING_APPROVAL)
  gstRate     Decimal       @default(12.0) @db.Decimal(5, 2) // 0%, 5%, 12%, 18%, 28%
  weightGrams Int           @default(500)
  lengthCm    Decimal       @default(25.0) @db.Decimal(6, 2)
  widthCm     Decimal       @default(20.0) @db.Decimal(6, 2)
  heightCm    Decimal       @default(5.0) @db.Decimal(6, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants ProductVariant[]
  images   ProductImage[]
  reviews  ProductReview[]

  @@map("products")
  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  SKU       String   @unique
  barcode   String?
  size      String   // S, M, L, XL, Free Size
  color     String   // Royal Indigo, Wine Red, etc.
  price     Decimal  @db.Decimal(12, 2) // Selling price
  mrp       Decimal  @db.Decimal(12, 2) // Original price
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory          Inventory?
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@map("product_variants")
  @@index([productId])
  @@index([SKU])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model Inventory {
  id           String         @id @default(uuid())
  variantId    String         @unique
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  availableQty Int            @default(0)
  reservedQty  Int            @default(0) // reserved during active checkout
  updatedAt    DateTime       @updatedAt

  @@map("inventory")
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ORDER_RESERVED
  ORDER_FULFILLED
  ORDER_CANCELLED
  RETURN_RECEIVED
  AUDIT_CORRECTION
}

model InventoryMovement {
  id           String                @id @default(uuid())
  variantId    String
  variant      ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity     Int                   // positive for addition, negative for reduction
  movementType InventoryMovementType
  referenceId  String?               // orderId, returnId, or auditId
  notes        String?
  createdAt    DateTime              @default(now())

  @@map("inventory_movements")
  @@index([variantId])
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())

  @@map("product_reviews")
}

// =============================================================================
// SECTION 2.C: ORDERS, SUBORDERS & SHIPPING TABLES
// =============================================================================

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURNED
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique // e.g. "PB-ORD-92841"
  customerId    String
  customer      User          @relation(fields: [customerId], references: [id])
  totalAmount   Decimal       @db.Decimal(12, 2)
  discountAmount Decimal      @default(0.0) @db.Decimal(12, 2)
  deliveryFee   Decimal       @default(0.0) @db.Decimal(12, 2)
  finalAmount   Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(CONFIRMED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orderItems   OrderItem[]
  sellerOrders SellerOrder[]
  addresses    OrderAddress?
  payments     Payment[]
  shipments    Shipment[]
  refunds      Refund[]

  @@map("orders")
  @@index([orderNumber])
  @@index([customerId])
}

// Section 5: Multi-Seller Suborders Architecture
model SellerOrder {
  id               String        @id @default(uuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           SellerProfile @relation(fields: [sellerId], references: [id])
  subtotal         Decimal       @db.Decimal(12, 2) // Gross sales for this seller
  commissionAmount Decimal       @db.Decimal(12, 2) // 10% or category take-rate
  taxOnCommission  Decimal       @db.Decimal(12, 2) // 18% GST on commission
  netEarnings      Decimal       @db.Decimal(12, 2) // Subtotal - Commission - GST
  status           OrderStatus   @default(CONFIRMED)
  trackingNumber   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items     OrderItem[]
  shipments Shipment[]

  @@unique([orderId, sellerId])
  @@map("seller_orders")
}

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrderId String?
  sellerOrder   SellerOrder?   @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  sellerId      String         // Invariant: every order item retains its seller ID
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  quantity      Int
  unitPrice     Decimal        @db.Decimal(12, 2)
  totalPrice    Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())

  commissionEntry CommissionEntry?
  returns         Return[]

  @@map("order_items")
  @@index([sellerId])
}

model OrderAddress {
  id              String   @id @default(uuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingAddress Json     // Name, phone, street, city, state, pincode
  billingAddress  Json
  createdAt       DateTime @default(now())

  @@map("order_addresses")
}

enum ShipmentStatus {
  MANIFESTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

model Shipment {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrderId  String?
  sellerOrder    SellerOrder?   @relation(fields: [sellerOrderId], references: [id])
  sellerId       String
  seller         SellerProfile  @relation(fields: [sellerId], references: [id])
  courier        String         // "BlueDart Express", "Delhivery Air", "Shiprocket"
  trackingNumber String         @unique
  labelUrl       String?
  status         ShipmentStatus @default(MANIFESTED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  events ShipmentEvent[]

  @@map("shipments")
  @@index([trackingNumber])
}

model ShipmentEvent {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  event      String   // "Package Manifested", "Arrived at Hub", "Out for Delivery"
  location   String
  eventDate  DateTime @default(now())

  @@map("shipment_events")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  PICKED_UP
  REPLACED
  REFUNDED
  REJECTED
}

model Return {
  id          String       @id @default(uuid())
  orderItemId String
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])
  reason      String
  status      ReturnStatus @default(REQUESTED)
  actionNotes String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("returns")
}

model Refund {
  id                   String        @id @default(uuid())
  orderId              String
  order                Order         @relation(fields: [orderId], references: [id])
  amount               Decimal       @db.Decimal(12, 2)
  status               PaymentStatus @default(PAID)
  transactionReference String        // Payment gateway refund ID
  createdAt            DateTime      @default(now())

  @@map("refunds")
}

// =============================================================================
// SECTION 2.D: FINANCE, WALLETS, SETTLEMENTS & COMMISSIONS
// =============================================================================

model Payment {
  id               String        @id @default(uuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway          String        // "CASHFREE", "RAZORPAY", "UPI_SIMULATOR", "COD"
  gatewayReference String        // e.g. "cf_order_92841"
  amount           Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(PAID)
  createdAt        DateTime      @default(now())

  @@map("payments")
}

model CommissionRule {
  id                   String    @id @default(uuid())
  categoryId           String
  category             Category  @relation(fields: [categoryId], references: [id])
  commissionPercentage Decimal   @default(10.0) @db.Decimal(5, 2)
  fixedFee             Decimal   @default(0.0) @db.Decimal(8, 2)
  createdAt            DateTime  @default(now())

  @@map("commission_rules")
}

model CommissionEntry {
  id               String        @id @default(uuid())
  orderItemId      String        @unique
  orderItem        OrderItem     @relation(fields: [orderItemId], references: [id])
  sellerId         String
  seller           SellerProfile @relation(fields: [sellerId], references: [id])
  grossAmount      Decimal       @db.Decimal(12, 2)
  commissionAmount Decimal       @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())

  @@map("commission_entries")
}

model SellerWallet {
  id               String        @id @default(uuid())
  sellerId         String        @unique
  seller           SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  availableBalance Decimal       @default(0.0) @db.Decimal(14, 2) // Ready for withdrawal
  pendingBalance   Decimal       @default(0.0) @db.Decimal(14, 2) // In-transit orders
  updatedAt        DateTime      @updatedAt

  @@map("seller_wallets")
}

enum TransactionType {
  ORDER_CREDIT
  COMMISSION_DEBIT
  SETTLEMENT_PAYOUT
  RETURN_DEBIT
  PENALTY_DEBIT
  ADJUSTMENT
}

model SellerTransaction {
  id          String          @id @default(uuid())
  sellerId    String
  seller      SellerProfile   @relation(fields: [sellerId], references: [id])
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2) // Immutable record
  referenceId String?         // orderId, settlementId
  notes       String?
  createdAt   DateTime        @default(now())

  settlementItems SettlementItem[]

  @@map("seller_transactions")
  @@index([sellerId])
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

model Settlement {
  id             String           @id @default(uuid())
  sellerId       String
  seller         SellerProfile    @relation(fields: [sellerId], references: [id])
  amount         Decimal          @db.Decimal(12, 2)
  status         SettlementStatus @default(PENDING)
  bankRefNumber  String?          // NEFT / UTR reference
  settlementDate DateTime?
  createdAt      DateTime         @default(now())

  items SettlementItem[]

  @@map("settlements")
}

model SettlementItem {
  id            String            @id @default(uuid())
  settlementId  String
  settlement    Settlement        @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   SellerTransaction @relation(fields: [transactionId], references: [id])

  @@map("settlement_items")
}

// =============================================================================
// SECTION 2.E: ADMIN AND SYSTEM TABLES
// =============================================================================

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("SUPER_ADMIN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // "SELLER_APPROVED", "COMMISSION_CHANGED", "PAYOUT_RELEASED"
  entity    String   // "SellerProfile", "Order", "Product"
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model SupportTicket {
  id          String   @id @default(uuid())
  sellerId    String?
  customerId  String?
  subject     String
  category    String
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  messages    Json     // Array of thread messages
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("support_tickets")
}

model Coupon {
  id             String   @id @default(uuid())
  code           String   @unique
  description    String
  discountType   String   // "PERCENTAGE" or "FLAT"
  discountValue  Decimal  @db.Decimal(8, 2)
  minOrderAmount Decimal  @db.Decimal(12, 2)
  maxDiscount    Decimal? @db.Decimal(8, 2)
  isActive       Boolean  @default(true)
  validUntil     DateTime
  createdAt      DateTime @default(now())

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  orderId   String
  createdAt DateTime @default(now())

  @@map("coupon_usages")
}

model PlatformSettings {
  id                      String   @id @default(uuid())
  defaultCommissionRate   Decimal  @default(12.0) @db.Decimal(5, 2)
  freeDeliveryThreshold   Decimal  @default(999.0) @db.Decimal(8, 2)
  gstNumber               String   @default("09AAECV1234M1Z2")
  settlementCycleDays     Int      @default(2) // T+2
  updatedAt               DateTime @updatedAt

  @@map("platform_settings")
}
