  subtotal               Decimal       @db.Decimal(12, 2)
  shippingFee            Decimal       @default(0.0) @db.Decimal(10, 2)
  taxAmount              Decimal       @default(0.0) @db.Decimal(10, 2)
  fulfillmentGroup       String?
  commissionAmount       Decimal       @db.Decimal(12, 2)
  taxOnCommission        Decimal       @db.Decimal(12, 2)
  netEarnings            Decimal       @db.Decimal(12, 2)
  status                 OrderStatus   @default(CONFIRMED)
  trackingNumber         String?
  courierPartner         String?
  shippingLabelGenerated Boolean       @default(false)
  pickupDate             DateTime?
  cancellationReason     String?
