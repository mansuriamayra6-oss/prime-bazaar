// Prisma Schema for Multi-Vendor E-Commerce Marketplace (Prime Bazaar)
// Central database supporting Customer App (Web/Flutter), Seller Portal, and Super Admin Console

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 1. ACCOUNTS, AUTHENTICATION & ACCESS CONTROL
// -----------------------------------------------------------------------------

enum UserType {
  CUSTOMER
  SELLER
  ADMIN
  STAFF
}

model User {
  id              String            @id @default(uuid())
  email           String?           @unique
  phone           String?           @unique
  passwordHash    String?
  name            String
  avatarUrl       String?
  userType        UserType          @default(CUSTOMER)
  isActive        Boolean           @default(true)
  isVerified      Boolean           @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  // Relations
  profile         CustomerProfile?
  addresses       Address[]
  userRoles       UserRole[]
  sessions        Session[]
  orders          Order[]
  carts           Cart[]
  wishlists       Wishlist[]
  reviews         Review[]
  supportTickets  SupportTicket[]
  sellerUsers     SellerUser[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([phone])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // e.g. SUPER_ADMIN, OPERATIONS_ADMIN, FINANCE_MANAGER
  description String?
  userRoles   UserRole[]
  permissions RolePermission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  slug        String           @unique // e.g. products:approve, settlements:release
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// -----------------------------------------------------------------------------
// 2. CUSTOMER PROFILES & ADDRESSES
// -----------------------------------------------------------------------------

enum MemberTier {
  SILVER
  GOLD
  PLATINUM
}

model CustomerProfile {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberTier  MemberTier @default(SILVER)
  coinBalance Int        @default(340) // 1 coin = 1 minor unit (or 1 INR)
  referralCode String    @unique
  referredBy  String?
  dob         DateTime?
  gender      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model Address {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  street       String
  city         String
  state        String
  pinCode      String
  country      String      @default("IN")
  type         AddressType @default(HOME)
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orders       Order[]

  @@index([userId])
}

// -----------------------------------------------------------------------------
// 3. SELLERS & VENDOR PORTAL
// -----------------------------------------------------------------------------

enum SellerStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

model Seller {
  id             String           @id @default(uuid())
  businessName   String
  legalName      String
  gstin          String?          @unique
  pan            String?
  email          String           @unique
  phone          String
  status         SellerStatus     @default(PENDING_VERIFICATION)
  rating         Float            @default(5.0)
  commissionRate Float            @default(8.0) // percentage
  walletBalance  Int              @default(0) // integer minor currency units
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  users          SellerUser[]
  documents      SellerDocument[]
  bankAccounts   SellerBankAccount[]
  products       Product[]
  orderFulfillments SellerFulfillment[]
  settlements    Settlement[]
  sellerLedgers  SellerLedger[]
  warehouses     Warehouse[]

  @@index([businessName])
  @@index([status])
}

model SellerUser {
  id        String   @id @default(uuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  @@unique([sellerId, userId])
}

model SellerDocument {
  id          String   @id @default(uuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  docType     String   // GST_CERTIFICATE, PAN_CARD, CANCELLED_CHEQUE
  fileUrl     String
  isVerified  Boolean  @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
}

model SellerBankAccount {
  id            String   @id @default(uuid())
  sellerId      String
  seller        Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  accountNumber String
  ifscCode      String
  bankName      String
  beneficiaryName String
  isDefault     Boolean  @default(true)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// -----------------------------------------------------------------------------
// 4. CATALOGUE, PRODUCTS & VARIANTS
// -----------------------------------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  name        String
  slug        String     @unique
  imageUrl    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  isVerified  Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  REJECTED
}

model Product {
  id              String           @id @default(uuid())
  sellerId        String
  seller          Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?           @relation(fields: [brandId], references: [id])
  title           String
  slug            String           @unique
  description     String
  fabric          String?
  fit             String?
  mrp             Int              // in paise
  sellingPrice    Int              // in paise
  discountPercent Int              @default(0)
  status          ProductStatus    @default(ACTIVE)
  rating          Float            @default(5.0)
  reviewCount     Int              @default(0)
  isTrending      Boolean          @default(false)
  isFeatured      Boolean          @default(false)
  isCodAllowed    Boolean          @default(true)
  returnWindowDays Int             @default(7)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  variants        ProductVariant[]
  images          ProductImage[]
  attributes      ProductAttribute[]
  reviews         Review[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
}

model ProductVariant {
  id           String      @id @default(uuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String      @unique
  size         String
  colorName    String
  colorHex     String
  price        Int         // in paise
  mrp          Int         // in paise
  stock        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  inventory    Inventory[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String   // e.g. "Weave", "Occasion", "Sleeve Length"
  value     String
}

// -----------------------------------------------------------------------------
// 5. INVENTORY & WAREHOUSES
// -----------------------------------------------------------------------------

model Warehouse {
  id          String      @id @default(uuid())
  sellerId    String
  seller      Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  address     String
  city        String
  pinCode     String
  inventories Inventory[]
  createdAt   DateTime    @default(now())
}

model Inventory {
  id          String         @id @default(uuid())
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  available   Int            @default(0)
  reserved    Int            @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt   DateTime       @updatedAt

  movements   StockMovement[]

  @@unique([warehouseId, variantId])
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  ORDER_RESERVED
  ORDER_FULFILLED
  ORDER_CANCELLED
  RETURN_RECEIVED
}

model StockMovement {
  id          String       @id @default(uuid())
  inventoryId String
  inventory   Inventory    @relation(fields: [inventoryId], references: [id])
  type        MovementType
  quantity    Int
  notes       String?
  createdAt   DateTime     @default(now())
}

// -----------------------------------------------------------------------------
// 6. CARTS & WISHLISTS
// -----------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String         @default("Default Wishlist")
  items     WishlistItem[]
  createdAt DateTime       @default(now())
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

// -----------------------------------------------------------------------------
// 7. ORDERS & MULTI-SELLER FULFILLMENT
// -----------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURNED
}

model Order {
  id              String              @id @default(uuid())
  orderNumber     String              @unique // e.g. TB-88492
  userId          String
  user            User                @relation(fields: [userId], references: [id])
  addressId       String
  shippingAddress Address             @relation(fields: [addressId], references: [id])
  totalMrp        Int                 // in paise
  totalDiscount   Int                 // in paise
  couponDiscount  Int                 @default(0)
  coinsDiscount   Int                 @default(0)
  deliveryFee     Int                 @default(0)
  finalAmount     Int                 // in paise
  currency        String              @default("INR")
  status          OrderStatus         @default(CONFIRMED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  fulfillments    SellerFulfillment[]
  payments        Payment[]
  shipments       Shipment[]
  returnRequests  ReturnRequest[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

// Seller-specific order fulfillment group (splits multi-seller baskets)
model SellerFulfillment {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         Seller         @relation(fields: [sellerId], references: [id])
  subtotal       Int            // in paise
  commission     Int            // in paise
  sellerPayout   Int            // in paise
  status         OrderStatus    @default(CONFIRMED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  orderItems     OrderItem[]
  shipments      Shipment[]

  @@unique([orderId, sellerId])
}

model OrderItem {
  id                  String             @id @default(uuid())
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerFulfillmentId String?
  fulfillment         SellerFulfillment? @relation(fields: [sellerFulfillmentId], references: [id])
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  variantId           String
  variant             ProductVariant     @relation(fields: [variantId], references: [id])
  priceSnapshot       Int                // in paise at purchase time
  quantity            Int
  taxRate             Float              @default(5.0)
  commissionRate      Float              // snapshot of commission %
  commissionAmount    Int                // in paise
  createdAt           DateTime           @default(now())

  returnItems         ReturnItem[]
}

// -----------------------------------------------------------------------------
// 8. PAYMENTS & RECONCILIATION
// -----------------------------------------------------------------------------

enum PaymentMethod {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  COD
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id              String               @id @default(uuid())
  orderId         String
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gatewayProvider String               // e.g. "RAZORPAY", "CASHFREE"
  gatewayPaymentId String?             @unique
  method          PaymentMethod
  amount          Int                  // in paise
  currency        String               @default("INR")
  status          PaymentStatus        @default(INITIATED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  transactions    PaymentTransaction[]
  refunds         Refund[]

  @@index([orderId])
}

model PaymentTransaction {
  id           String   @id @default(uuid())
  paymentId    String
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  action       String   // CAPTURE, REFUND, VERIFY
  rawPayload   Json
  createdAt    DateTime @default(now())
}

model PaymentWebhook {
  id          String   @id @default(uuid())
  eventId     String   @unique
  provider    String
  payload     Json
  isProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// -----------------------------------------------------------------------------
// 9. SETTLEMENTS & FINANCIAL LEDGER
// -----------------------------------------------------------------------------

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Settlement {
  id           String           @id @default(uuid())
  sellerId     String
  seller       Seller           @relation(fields: [sellerId], references: [id])
  amount       Int              // in paise
  status       SettlementStatus @default(PENDING)
  bankRefNumber String?
  settledAt    DateTime?
  createdAt    DateTime         @default(now())

  items        SettlementItem[]
}

model SettlementItem {
  id           String     @id @default(uuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  orderId      String
  grossAmount  Int
  commission   Int
  netPayout    Int
}

model SellerLedger {
  id          String   @id @default(uuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id])
  type        String   // CREDIT (order delivered), DEBIT (settlement payout, return)
  amount      Int      // in paise
  balanceAfter Int     // in paise
  refOrderId  String?
  notes       String?
  createdAt   DateTime @default(now())
}

// -----------------------------------------------------------------------------
// 10. SHIPMENTS & LIVE TRACKING
// -----------------------------------------------------------------------------

enum ShipmentStatus {
  MANIFESTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

model Shipment {
  id                  String             @id @default(uuid())
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerFulfillmentId String?
  fulfillment         SellerFulfillment? @relation(fields: [sellerFulfillmentId], references: [id])
  courierPartner      String             // "BLUEDART", "DELHIVERY", "SHIPROCKET"
  awbNumber           String             @unique
  shippingLabelUrl    String?
  status              ShipmentStatus     @default(MANIFESTED)
  estimatedDelivery   DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  trackingEvents      TrackingEvent[]
}

model TrackingEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  location    String
  statusText  String
  eventTime   DateTime @default(now())
}

// -----------------------------------------------------------------------------
// 11. RETURNS & REFUNDS
// -----------------------------------------------------------------------------

enum ReturnStatus {
  REQUESTED
  APPROVED
  PICKUP_SCHEDULED
  INSPECTED
  REPLACED
  REFUNDED
  REJECTED
}

model ReturnRequest {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason      String
  status      ReturnStatus @default(REQUESTED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items       ReturnItem[]
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
}

model Refund {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id])
  amount      Int      // in paise
  reason      String
  createdAt   DateTime @default(now())
}

// -----------------------------------------------------------------------------
// 12. PROMOTIONS, COUPONS & MARKETING
// -----------------------------------------------------------------------------

model Coupon {
  id             String        @id @default(uuid())
  code           String        @unique
  description    String
  discountType   String        // FLAT, PERCENTAGE
  discountValue  Int
  minOrderAmount Int
  maxDiscount    Int?
  usageLimit     Int           @default(10000)
  usedCount      Int           @default(0)
  validUntil     DateTime
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  usages         CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  orderId   String
  createdAt DateTime @default(now())
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  imageUrl    String
  actionUrl   String?
  categorySlug String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
}

// -----------------------------------------------------------------------------
// 13. REVIEWS, NOTIFICATIONS & SUPPORT
// -----------------------------------------------------------------------------

model Review {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  rating      Int
  comment     String
  isVerified  Boolean  @default(true)
  helpfulCount Int     @default(0)
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  subject   String
  status    String          @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority  String          @default("NORMAL")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  messages  TicketMessage[]
}

model TicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String        // "USER", "AGENT", "BOT"
  body      String
  createdAt DateTime      @default(now())
}

// -----------------------------------------------------------------------------
// 14. ADMIN SETTINGS, AUDIT LOGS & FEATURE FLAGS
// -----------------------------------------------------------------------------

model AdminSetting {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "marketplace_commission_rate", "free_shipping_threshold"
  value     String
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "enable_virtual_try_on", "enable_trendstream"
  isEnabled   Boolean  @default(true)
  description String?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  resource  String
  metadata  Json?
  createdAt DateTime @default(now())
}
