enum InvoiceStatus {
  ISSUED
  ADJUSTED
  VOID
}

model TaxInvoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  financialYear      String
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrderId      String?
  sellerOrder        SellerOrder?  @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  sellerId           String
  seller             SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  buyerUserId        String
  buyer              User          @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  sellerGstin        String?
  buyerGstin         String?
  sellerState        String
  placeOfSupplyState String
  isInterState       Boolean
  missingGstFlag     Boolean       @default(false)
  taxableValue       Decimal       @db.Decimal(12, 2)
  cgstAmount         Decimal       @default(0.0) @db.Decimal(12, 2)
  sgstAmount         Decimal       @default(0.0) @db.Decimal(12, 2)
  igstAmount         Decimal       @default(0.0) @db.Decimal(12, 2)
  shippingTaxable    Decimal       @default(0.0) @db.Decimal(12, 2)
  shippingTax        Decimal       @default(0.0) @db.Decimal(12, 2)
  discountTotal      Decimal       @default(0.0) @db.Decimal(12, 2)
  grandTotal         Decimal       @db.Decimal(12, 2)
  status             InvoiceStatus @default(ISSUED)
  sellerSnapshot     Json
  buyerSnapshot      Json
  issuedAt           DateTime      @default(now())

  items       TaxInvoiceItem[]
  creditNotes CreditNote[]

  @@unique([orderId, sellerOrderId])
  @@index([buyerUserId])
  @@index([sellerId])
  @@map("tax_invoices")
}

model TaxInvoiceItem {
  id             String     @id @default(uuid())
  invoiceId      String
  invoice        TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  orderItemId    String?
  orderItem      OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  hsnCode        String
  description    String
  quantity       Int
  unitPrice      Decimal    @db.Decimal(12, 2)
  discountAmount Decimal    @default(0.0) @db.Decimal(12, 2)
  taxableValue   Decimal    @db.Decimal(12, 2)
  gstRate        Decimal    @db.Decimal(5, 2)
  cgst           Decimal    @default(0.0) @db.Decimal(12, 2)
  sgst           Decimal    @default(0.0) @db.Decimal(12, 2)
  igst           Decimal    @default(0.0) @db.Decimal(12, 2)
  totalAmount    Decimal    @db.Decimal(12, 2)

  @@map("tax_invoice_items")
}

model CreditNote {
  id                String     @id @default(uuid())
  creditNoteNumber  String     @unique
  financialYear     String
