enum TransactionType {
  ORDER_CREDIT
  COMMISSION_DEBIT
  SETTLEMENT_PAYOUT
  RETURN_DEBIT
  AD_SPEND_DEBIT
  PENALTY_DEBIT
  ADJUSTMENT
}

model SellerTransaction {
  id          String          @id @default(uuid())
  sellerId    String
  seller      SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
