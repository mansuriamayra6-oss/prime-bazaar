enum AdCampaignStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model AdCampaign {
