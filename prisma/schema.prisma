  @@index([sellerId])
  @@index([offerId])
  @@map("order_items")
}

model OrderAddress {
  id              String   @id @default(uuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shippingAddress Json
  billingAddress  Json
  buyerGstin      String?
  createdAt       DateTime @default(now())

  @@map("order_addresses")
}

enum ShipmentStatus {
  MANIFESTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
  RTO_INITIATED
  RTO_DELIVERED
}

model Shipment {
  id                 String         @id @default(uuid())
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrderId      String?
  sellerOrder        SellerOrder?   @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  sellerId           String
  seller             SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  warehouseId        String?
  warehouse          Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  providerName       String         @default("UNCONFIGURED")
  providerShipmentId String?
  providerOrderId    String?
  courier            String
  trackingNumber     String         @unique
  labelUrl           String?
  shippingCost       Decimal        @default(0.0) @db.Decimal(10, 2)
  status             ShipmentStatus @default(MANIFESTED)
