  updatedAt          DateTime       @updatedAt

  events      ShipmentEvent[]
  deliveryOtp DeliveryOtp?

  @@index([trackingNumber])
  @@index([orderId])
  @@map("shipments")
}

model ShipmentEvent {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  event      String
  location   String
  eventDate  DateTime @default(now())

  @@map("shipment_events")
}

model DeliveryOtp {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipmentId     String    @unique
  shipment       Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  otpHash        String
  channel        String    @default("EMAIL")
  expiresAt      DateTime
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(5)
  lockedUntil    DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  overrideReason String?
  overrideBy     String?
  isInvalidated  Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([orderId])
  @@map("delivery_otps")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  PICKED_UP
  RECEIVED
  REPLACED
  REFUNDED
  REJECTED
}

model Return {
  id          String        @id @default(uuid())
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  quantity    Int           @default(1)
  reason      String
  status      ReturnStatus  @default(REQUESTED)
  actionNotes String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  refund Refund?

  @@index([sellerId])
  @@map("returns")
}

enum RefundMode {
  ORIGINAL_METHOD
  STORE_CREDIT
}

enum RefundLifecycleStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Refund {
  id                   String                @id @default(uuid())
  orderId              String
  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId          String?
  orderItem            OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  returnId             String?               @unique
  returnRecord         Return?               @relation(fields: [returnId], references: [id], onDelete: Restrict)
  paymentId            String?
  payment              Payment?              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  idempotencyKey       String                @unique
  amount               Decimal               @db.Decimal(12, 2)
  refundMode           RefundMode            @default(ORIGINAL_METHOD)
  status               RefundLifecycleStatus @default(PENDING)
  reason               String
  transactionReference String                @unique
  providerStatus       String?
  providerPayload      Json?
  processedBy          String?
  processedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  creditNotes           CreditNote[]
  storeCreditTxns       StoreCreditTransaction[]
  reconciliationMatches ReconciliationItem[]

  @@index([orderId])
  @@map("refunds")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  idempotencyKey    String?       @unique
  gateway           String
  gatewayReference  String
  cfPaymentId       String?
  paymentMethod     String?
  amount            Decimal       @db.Decimal(12, 2)
  gatewayFee        Decimal       @default(0.0) @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  rawProviderStatus String?
  verifiedAt        DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  refunds               Refund[]
  reconciliationMatches ReconciliationItem[]

  @@index([orderId])
  @@index([gatewayReference])
  @@map("payments")
}

