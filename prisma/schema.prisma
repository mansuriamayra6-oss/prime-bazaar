  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  invoices      SupplierInvoice[]

  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String         @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderedQty      Int
  receivedQty     Int            @default(0)
  rejectedQty     Int            @default(0)
  unitCost        Decimal        @db.Decimal(12, 2)
  taxRate         Decimal        @default(12.0) @db.Decimal(5, 2)
  lineTotal       Decimal        @db.Decimal(12, 2)

  receiptItems GoodsReceiptItem[]

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                 String        @id @default(uuid())
  grnNumber          String        @unique
  purchaseOrderId    String
  purchaseOrder      PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouseId        String
  warehouse          Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy         String
  supplierInvoiceRef String?
  notes              String?
  receivedAt         DateTime      @default(now())

  items GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id              String            @id @default(uuid())
  grnId           String
  grn             GoodsReceipt      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItemId        String
  poItem          PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Restrict)
  variantId       String
  variant         ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  acceptedQty     Int
  damagedQty      Int               @default(0)
  discrepancyNote String?

  @@map("goods_receipt_items")
}

model SupplierInvoice {
  id              String        @id @default(uuid())
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  invoiceNumber   String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0.0) @db.Decimal(12, 2)
  status          String        @default("UNPAID")
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@map("supplier_invoices")
}

// =============================================================================
// SECTION 10: ADMIN, STAFF PERMISSIONS, AUDIT LOGS, MARKETING & SUPPORT
// =============================================================================

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("SUPER_ADMIN")
  permissions  Json?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

model AdminRolePermission {
  id          String   @id @default(uuid())
  roleName    String   @unique
  description String?
  permissions Json
  updatedAt   DateTime @updatedAt

  @@map("admin_role_permissions")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorRole     String   @default("SYSTEM")
  action        String
  entity        String
  entityId      String
  beforeState   Json?
  afterState    Json?
  reason        String?
  correlationId String?
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([action, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

enum PriceAlertStatus {
  ACTIVE
  TRIGGERED
  PAUSED
  CANCELLED
}

model PriceAlert {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productTitle    String
  initialPrice    Decimal          @db.Decimal(12, 2)
  targetPrice     Decimal?         @db.Decimal(12, 2)
  currentPrice    Decimal          @db.Decimal(12, 2)
  lowestPriceSeen Decimal          @db.Decimal(12, 2)
  notifyOnAnyDrop Boolean          @default(true)
  status          PriceAlertStatus @default(ACTIVE)
  lastCheckedAt   DateTime?
  triggeredAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([status])
  @@map("price_alerts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("GENERAL")
  channel   String   @default("IN_APP")
  title     String
  message   String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model SupportTicket {
  id         String         @id @default(uuid())
  sellerId   String?
  seller     SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  customerId String?
  customer   User?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId    String?
  subject    String
  category   String
  priority   String         @default("MEDIUM")
  status     String         @default("OPEN")
  messages   Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  threadMessages SupportTicketMessage[]

  @@index([customerId])
  @@index([sellerId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  senderRole String
  senderName String
  message    String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
  @@map("support_ticket_messages")
}

model Coupon {
  id             String   @id @default(uuid())
  code           String   @unique
  description    String
  discountType   String
  discountValue  Decimal  @db.Decimal(8, 2)
  minOrderAmount Decimal  @db.Decimal(12, 2)
  maxDiscount    Decimal? @db.Decimal(8, 2)
  isActive       Boolean  @default(true)
  validUntil     DateTime
  createdAt      DateTime @default(now())

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId    String
  orderId   String
  createdAt DateTime @default(now())

  @@map("coupon_usages")
}

model PlatformSettings {
  id                    String   @id @default(uuid())
  defaultCommissionRate Decimal  @default(12.0) @db.Decimal(5, 2)
  freeDeliveryThreshold Decimal  @default(999.0) @db.Decimal(8, 2)
  gstNumber             String   @default("09AAECV1234M1Z2")
  platformState         String   @default("Maharashtra")
  settlementCycleDays   Int      @default(2)
  updatedAt             DateTime @updatedAt

  @@map("platform_settings")
}

// =========================================================================
// PHASE 6D: LOYALTY, REWARDS, REFERRALS & TIERS
// =========================================================================

model MembershipTierConfig {
  id             String   @id @default(uuid())
  tierName       String   @unique
  minLifetimePts Int      @default(0)
  earnMultiplier Decimal  @default(1.0) @db.Decimal(4, 2)
  perksJson      Json?
  updatedAt      DateTime @updatedAt

  @@map("membership_tier_configs")
}

model LoyaltyAccount {
  id                String   @id @default(uuid())
  userId            String   @unique
  coinsBalance      Int      @default(0)
  lifetimeCoins     Int      @default(0)
  tierName          String   @default("SILVER")
  streakDays        Int      @default(0)
  lastCheckInDate   String?
  referralCode      String   @unique
  referredByUserId  String?
  personalizationOn Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  transactions RewardTransaction[]

  @@map("loyalty_accounts")
}

model RewardTransaction {
  id               String         @id @default(uuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  type             String
  coinsDelta       Int
  description      String
  referenceId      String?
  expiresAt        DateTime?
  expiredProcessed Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@index([loyaltyAccountId])
  @@map("reward_transactions")
}

model ReferralInvite {
  id             String    @id @default(uuid())
  referrerUserId String
  referredUserId String?
  referralCode   String
  status         String    @default("PENDING")
  rewardCoins    Int       @default(150)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([referrerUserId])
  @@map("referral_invites")
}

// =========================================================================
// PHASE 6F: INTERNATIONAL MARKETPLACE & FX CONFIGURATION
// =========================================================================

model CountryConfig {
  id                 String   @id @default(uuid())
  countryCode        String   @unique
  countryName        String
  currencyCode       String
  isActive           Boolean  @default(true)
  shippingFeeInr     Decimal  @default(0.0) @db.Decimal(10, 2)
  customsDutyPercent Decimal  @default(0.0) @db.Decimal(5, 2)
  taxPercent         Decimal  @default(18.0) @db.Decimal(5, 2)
  codAllowed         Boolean  @default(true)
  cashfreeAllowed    Boolean  @default(true)
  postalPattern      String?
  updatedAt          DateTime @updatedAt

  @@map("country_configs")
}

model ExchangeRate {
  id           String   @id @default(uuid())
  currencyCode String   @unique
  rateFromInr  Decimal  @db.Decimal(12, 6)
  symbol       String
  sourceLabel  String   @default("Configured FX Reference Rate")
  updatedAt    DateTime @updatedAt

  @@map("exchange_rates")
}

// =========================================================================
// PHASE 6G: SUBSCRIPTIONS, B2B WHOLESALE & DIGITAL PRODUCTS
// =========================================================================

model SubscriptionPlan {
  id              String   @id @default(uuid())
  productId       String
  name            String
  intervalDays    Int      @default(30)
  discountPercent Decimal  @default(10.0) @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  subscriptions CustomerSubscription[]

  @@index([productId])
  @@map("subscription_plans")
}

model CustomerSubscription {
  id              String           @id @default(uuid())
  userId          String
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  status          String           @default("ACTIVE")
  nextRenewalAt   DateTime
  lastBillingNote String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@map("customer_subscriptions")
}

model B2BAccount {
  id           String    @id @default(uuid())
  userId       String    @unique
  companyName  String
  gstin        String
  businessType String    @default("RETAILER")
  status       String    @default("PENDING_VERIFICATION")
  verifiedBy   String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("b2b_accounts")
}

model BulkPriceTier {
  id              String @id @default(uuid())
  productId       String
  minQty          Int
  maxQty          Int?
  unitPriceInr    Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0.0) @db.Decimal(5, 2)

  @@index([productId])
  @@map("bulk_price_tiers")
}

model QuoteRequest {
  id               String   @id @default(uuid())
  b2bUserId        String
  productId        String
  sellerId         String
  requestedQty     Int
  targetUnitPrice  Decimal? @db.Decimal(12, 2)
  quotedUnitPrice  Decimal? @db.Decimal(12, 2)
  status           String   @default("REQUESTED")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([b2bUserId])
  @@index([sellerId])
  @@map("quote_requests")
}

model DigitalAsset {
  id           String   @id @default(uuid())
  productId    String   @unique
  sellerId     String
  fileName     String
  mimeType     String
  fileSizeKb   Int
  storageKey   String
  maxDownloads Int      @default(5)
  expiryHours  Int      @default(72)
  createdAt    DateTime @default(now())

  grants DigitalDownloadGrant[]

  @@map("digital_assets")
}

model DigitalDownloadGrant {
  id            String       @id @default(uuid())
  assetId       String
  asset         DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId        String
  orderId       String
  downloadsUsed Int          @default(0)
  maxDownloads  Int          @default(5)
  expiresAt     DateTime
  status        String       @default("ACTIVE")
  revokedReason String?
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([orderId])
  @@map("digital_download_grants")
}

