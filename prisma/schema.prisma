// =============================================================================
// PRIME BAZAAR - CENTRAL MULTI-VENDOR MARKETPLACE POSTGRESQL PRISMA SCHEMA
// Phases 1-5: Auth/RBAC, Storefront, Customer Accounts, Payments/Refunds,
// Gift Cards/Store Credits, Multi-Warehouse, Shipping/OTP, GST Invoices,
// Double-Entry Ledger & Reconciliation, Seller Ops, Admin CMS, Ads, Suppliers/PO
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// SECTION 1: USERS, SESSIONS, RBAC & CUSTOMER ACCOUNTS
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String?    @unique
  phone         String?    @unique
  passwordHash  String?
  avatar        String?
  memberTier    String     @default("Silver")
  coins         Int        @default(0)
  status        UserStatus @default(ACTIVE)
  deactivatedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  userRoles              UserRole[]
  sessions               UserSession[]
  passwordResetTokens    PasswordResetToken[]
  customerAddresses      CustomerAddress[]
  wishlistItems          WishlistItem[]
  notificationPreference NotificationPreference?
  sellerProfile          SellerProfile?
  sellerStaff            SellerStaffMember[]
  orders                 Order[]
  taxInvoices            TaxInvoice[]
  storeCreditAccount     StoreCreditAccount?
  storeCreditTxns        StoreCreditTransaction[]
  productReviews         ProductReview[]
  productQuestions       ProductQuestion[]
  productAnswers         ProductAnswer[]
  notifications          Notification[]
  priceAlerts            PriceAlert[]
  auditLogs              AuditLog[]
  supportTickets         SupportTicket[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  userRoles   UserRole[]
  createdAt   DateTime   @default(now())

  @@map("roles")
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  role       String    @default("CUSTOMER")
  sellerId   String?
  deviceName String?
  ipAddress  String?
  userAgent  String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model CustomerAddress {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  phone             String
  street            String
  city              String
  state             String
  pincode           String
  type              String   @default("home")
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@map("customer_addresses")
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled        Boolean  @default(true)
  smsEnabled          Boolean  @default(true)
  pushEnabled         Boolean  @default(true)
  inAppEnabled        Boolean  @default(true)
  orderUpdates        Boolean  @default(true)
  shippingUpdates     Boolean  @default(true)
  returnRefundUpdates Boolean  @default(true)
  promotionalMessages Boolean  @default(true)
  marketingOptIn      Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@map("notification_preferences")
}

// =============================================================================
// SECTION 2: SELLER PROFILES, KYC, STAFF & ONBOARDING
// =============================================================================

enum SellerApprovalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
  SUSPENDED
  DEACTIVATED
}

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  INDIVIDUAL_ARTISAN
}

model SellerProfile {
  id                String               @id @default(uuid())
  userId            String               @unique
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessName      String
  tradeName         String?
  businessType      BusinessType         @default(PROPRIETORSHIP)
  gstin             String?
  panNumber         String?
  approvalStatus    SellerApprovalStatus @default(PENDING_APPROVAL)
  rejectionReason   String?
  resubmissionNotes String?
  termsAcceptedAt   DateTime?
  termsVersion      String?
  reviewedBy        String?
  reviewedAt        DateTime?
  rating            Decimal              @default(5.0) @db.Decimal(3, 2)
  totalOrders       Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  documents         SellerDocument[]
  addresses         SellerAddress[]
  bankAccounts      SellerBankAccount[]
  settings          SellerSettings?
  onboardingHistory SellerOnboardingHistory[]
  staffMembers      SellerStaffMember[]
  warehouses        Warehouse[]
  products          Product[]
  offers            SellerOffer[]
  sellerOrders      SellerOrder[]
  shipments         Shipment[]
  returns           Return[]
  taxInvoices       TaxInvoice[]
  wallet            SellerWallet?
  transactions      SellerTransaction[]
  settlements       Settlement[]
  commissionEntries CommissionEntry[]
  adCampaigns       AdCampaign[]
  adBillingTxns     AdBillingTransaction[]
  supportTickets    SupportTicket[]

  @@index([businessName])
  @@index([approvalStatus])
  @@map("seller_profiles")
}

model SellerOnboardingHistory {
  id         String               @id @default(uuid())
  sellerId   String
  seller     SellerProfile        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  fromStatus SellerApprovalStatus?
  toStatus   SellerApprovalStatus
  reason     String?
  actorId    String
  createdAt  DateTime             @default(now())

  @@index([sellerId])
  @@map("seller_onboarding_history")
}

model SellerStaffMember {
  id          String        @id @default(uuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffRole   String        @default("MANAGER")
  permissions Json?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  @@unique([sellerId, userId])
  @@map("seller_staff_members")
}

enum DocumentType {
  PAN_CARD
  GSTIN_CERTIFICATE
  CANCELLED_CHEQUE
  ADDRESS_PROOF
  TRADE_LICENSE
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  RESUBMIT_REQUESTED
}

model SellerDocument {
  id                 String                     @id @default(uuid())
  sellerId           String
  seller             SellerProfile              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  documentType       DocumentType
  documentUrl        String
  mimeType           String?
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  rejectionNote      String?
  createdAt          DateTime                   @default(now())

  @@index([sellerId])
  @@map("seller_documents")
}

model SellerAddress {
  id        String        @id @default(uuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  address   String
  city      String
  state     String
  pincode   String
  isDefault Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@map("seller_addresses")
}

model SellerBankAccount {
  id                     String        @id @default(uuid())
  sellerId               String
  seller                 SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  accountHolder          String
  accountNumberEncrypted String
  accountLast4           String?
  bankName               String
  ifsc                   String
  isVerified             Boolean       @default(false)
  isDefault              Boolean       @default(true)
  createdAt              DateTime      @default(now())

  @@map("seller_bank_accounts")
}

model SellerSettings {
  id                   String        @id @default(uuid())
  sellerId             String        @unique
  seller               SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  returnPolicy         String        @default("7 days doorstep replacement for manufacturing defects")
  processingTimeDays   Int           @default(1)
  notificationSettings Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("seller_settings")
}

// =============================================================================
// SECTION 3: CMS, CATEGORIES, BRANDS, PRODUCTS, WAREHOUSES & INVENTORY
// =============================================================================

model Category {
  id                String           @id @default(uuid())
  name              String
  slug              String           @unique
  description       String?
  tagline           String?
  promoTitle        String?
  imageUrl          String?
  bannerUrl         String?
  sector            String?
  seoTitle          String?
  seoDescription    String?
  attributeSchema   Json?
  subcategoriesJson Json?
  level             Int              @default(1)
  displayOrder      Int              @default(0)
  isActive          Boolean          @default(true)
  isFashionPriority Boolean          @default(true)
  parentId          String?
  parent            Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children          Category[]       @relation("CategoryHierarchy")
  products          Product[]
  brandCategories   BrandCategory[]
  commissionRules   CommissionRule[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([isActive, displayOrder])
  @@map("categories")
}

model Brand {
  id              String          @id @default(uuid())
  name            String          @unique
  slug            String          @unique
  logoUrl         String?
  description     String?
  isActive        Boolean         @default(true)
  products        Product[]
  brandCategories BrandCategory[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("brands")
}

model BrandCategory {
  brandId    String
  categoryId String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([brandId, categoryId])
  @@map("brand_categories")
}

enum BannerStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model PromotionalBanner {
  id              String       @id @default(uuid())
  title           String
  eyebrow         String?
  subcopy         String?
  ctaLabel        String?
  targetUrl       String
  targetCategory  String?
  desktopImageUrl String
  mobileImageUrl  String?
  placement       String       @default("HERO")
  priority        Int          @default(0)
  status          BannerStatus @default(DRAFT)
  startsAt        DateTime?
  endsAt          DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, placement])
  @@map("promotional_banners")
}

enum ProductStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  REJECTED
  INACTIVE
  SUSPENDED
  ARCHIVED
}

model Product {
  id                String        @id @default(uuid())
  sellerId          String
  seller            SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             Brand?        @relation(fields: [brandId], references: [id])
  name              String
  description       String
  status            ProductStatus @default(PENDING_APPROVAL)
  rejectionReason   String?
  moderatedBy       String?
  moderatedAt       DateTime?
  hsnCode           String        @default("6204")
  taxClassification String        @default("APPAREL_STANDARD")
  gstRate           Decimal       @default(12.0) @db.Decimal(5, 2)
  weightGrams       Int           @default(500)
  lengthCm          Decimal       @default(25.0) @db.Decimal(6, 2)
  widthCm           Decimal       @default(20.0) @db.Decimal(6, 2)
  heightCm          Decimal       @default(5.0) @db.Decimal(6, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  variants         ProductVariant[]
  images           ProductImage[]
  offers           SellerOffer[]
  wishlistItems    WishlistItem[]
  reviews          ProductReview[]
  questions        ProductQuestion[]
  priceAlerts      PriceAlert[]
  adCampaignItems  AdCampaignProduct[]
  supplierProducts SupplierProduct[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

enum OfferCondition {
  NEW
  REFURBISHED
  OPEN_BOX
}

model SellerOffer {
  id           String         @id @default(uuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerSku    String
  condition    OfferCondition @default(NEW)
  price        Decimal        @db.Decimal(12, 2)
  mrp          Decimal        @db.Decimal(12, 2)
  stock        Int            @default(0)
  deliveryDays Int            @default(3)
  shippingFee  Decimal        @default(0.0) @db.Decimal(8, 2)
  codAvailable Boolean        @default(true)
  variantsJson Json?
  isDefault    Boolean        @default(false)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  orderItems           OrderItem[]
  warehouseInventories WarehouseInventory[]

  @@unique([productId, sellerId, condition])
  @@index([productId, isActive])
  @@index([sellerId])
  @@map("seller_offers")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  SKU       String   @unique
  barcode   String?
  size      String
  color     String
  price     Decimal  @db.Decimal(12, 2)
  mrp       Decimal  @db.Decimal(12, 2)
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory             Inventory?
  warehouseInventories  WarehouseInventory[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  orderItems            OrderItem[]
  supplierProducts      SupplierProduct[]
  purchaseOrderItems    PurchaseOrderItem[]
  goodsReceiptItems     GoodsReceiptItem[]
  warehouseTransfers    WarehouseTransfer[]

  @@index([productId])
  @@index([SKU])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Inventory {
  id           String         @id @default(uuid())
  variantId    String         @unique
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  availableQty Int            @default(0)
  reservedQty  Int            @default(0)
  updatedAt    DateTime       @updatedAt

  @@map("inventory")
}

model Warehouse {
  id             String         @id @default(uuid())
  sellerId       String?
  seller         SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  code           String         @unique
  name           String
  address        String
  city           String
  state          String
  pincode        String
  contactName    String?
  contactPhone   String?
  operatingHours String         @default("09:00-20:00")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  inventories       WarehouseInventory[]
  reservations      InventoryReservation[]
  shipments         Shipment[]
  transfersOutgoing WarehouseTransfer[]    @relation("TransferFromWarehouse")
  transfersIncoming WarehouseTransfer[]    @relation("TransferToWarehouse")
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]

  @@index([sellerId])
  @@index([state, isActive])
  @@map("warehouses")
}

model WarehouseInventory {
  id                String         @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  offerId           String?
  offer             SellerOffer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  availableQty      Int            @default(0)
  reservedQty       Int            @default(0)
  damagedQty        Int            @default(0)
  lowStockThreshold Int            @default(5)
  updatedAt         DateTime       @updatedAt

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@index([offerId])
  @@map("warehouse_inventories")
}

enum ReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
}

model InventoryReservation {
  id                 String            @id @default(uuid())
  orderId            String?
  order              Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  checkoutSessionKey String?
  warehouseId        String
  warehouse          Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variantId          String
  variant            ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity           Int
  status             ReservationStatus @default(RESERVED)
  expiresAt          DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([orderId])
  @@index([warehouseId, variantId, status])
  @@map("inventory_reservations")
}

enum TransferStatus {
  REQUESTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model WarehouseTransfer {
  id              String         @id @default(uuid())
  fromWarehouseId String
  fromWarehouse   Warehouse      @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity        Int
  status          TransferStatus @default(REQUESTED)
  initiatedBy     String
  notes           String?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("warehouse_transfers")
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ORDER_RESERVED
  ORDER_RELEASED
  ORDER_FULFILLED
  ORDER_CANCELLED
  RETURN_RECEIVED
  TRANSFER_OUT
  TRANSFER_IN
  PO_RECEIVED
  AUDIT_CORRECTION
}

model InventoryMovement {
  id           String                @id @default(uuid())
  variantId    String
  variant      ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouseId  String?
  quantity     Int
  movementType InventoryMovementType
  referenceId  String?
  notes        String?
  createdAt    DateTime              @default(now())

  @@index([variantId])
  @@index([warehouseId])
  @@map("inventory_movements")
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  REMOVED
}

model ProductReview {
  id               String           @id @default(uuid())
  productId        String
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  rating           Int              @default(5)
  comment          String
  verifiedPurchase Boolean          @default(false)
  helpfulCount     Int              @default(0)
  reportCount      Int              @default(0)
  status           ModerationStatus @default(APPROVED)
  moderationReason String?
  moderatedBy      String?
  moderatedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  media   ProductReviewMedia[]
  reports ProductReviewReport[]

  @@index([productId, status])
  @@map("product_reviews")
}

model ProductReviewMedia {
  id        String        @id @default(uuid())
  reviewId  String
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mediaType String
  mediaUrl  String
  caption   String?
  status    ModerationStatus @default(APPROVED)
  createdAt DateTime      @default(now())

  @@map("product_review_media")
}

model ProductReviewReport {
  id        String        @id @default(uuid())
  reviewId  String
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  reason    String
  createdAt DateTime      @default(now())

  @@unique([reviewId, userId])
  @@map("product_review_reports")
}

model ProductQuestion {
  id               String           @id @default(uuid())
  productId        String
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  question         String
  status           ModerationStatus @default(APPROVED)
  moderationReason String?
  moderatedBy      String?
  createdAt        DateTime         @default(now())

  answers ProductAnswer[]

  @@index([productId, status])
  @@map("product_questions")
}

model ProductAnswer {
  id               String           @id @default(uuid())
  questionId       String
  question         ProductQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  responderRole    String
  answer           String
  status           ModerationStatus @default(APPROVED)
  moderationReason String?
  moderatedBy      String?
  helpfulCount     Int              @default(0)
  createdAt        DateTime         @default(now())

  @@map("product_answers")
}

// =============================================================================
// SECTION 4: ORDERS, GIFT CARDS, STORE CREDITS, PAYMENTS, REFUNDS & SHIPPING
// =============================================================================

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  PARTIAL_REFUND
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURNED
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique
  idempotencyKey    String?       @unique
  customerId        String
  customer          User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  totalAmount       Decimal       @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0.0) @db.Decimal(12, 2)
  giftCardAmount    Decimal       @default(0.0) @db.Decimal(12, 2)
  storeCreditAmount Decimal       @default(0.0) @db.Decimal(12, 2)
  taxAmount         Decimal       @default(0.0) @db.Decimal(12, 2)
  deliveryFee       Decimal       @default(0.0) @db.Decimal(12, 2)
  finalAmount       Decimal       @db.Decimal(12, 2)
  paymentMethod     String        @default("cashfree")
  paymentStatus     PaymentStatus @default(PENDING)
  status            OrderStatus   @default(PENDING)
  gatewayOrderId    String?
  couponCode        String?
  coinsUsed         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  orderItems    OrderItem[]
  sellerOrders  SellerOrder[]
  addresses     OrderAddress?
  payments      Payment[]
